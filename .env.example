# Copy to .env and fill in. Never put a service_role / sb_secret_* key in any VITE_ variable:
# everything prefixed VITE_ is bundled into the browser.

# ─── Supabase (public site and partner portal) ──────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_UPLOADS_BUCKET=contact-attachments

# ─── Public site forms ──────────────────────────────────────────────────────
VITE_WEB3FORMS_ACCESS_KEY=

# ─── Partner portal (partners.joatglobal.com) ───────────────────────────────
# All optional; defaults shown.
# VITE_JOAT_SITE_URL=https://joatkenya.com
# VITE_AMARE_SITE_URL=https://amaresbigplanet.com
# Unset: the portal's contact page links to the main site's contact form.
# VITE_PARTNERS_SUPPORT_EMAIL=
